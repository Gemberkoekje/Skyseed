{
	chapter.5C0000000000A001.title: "Introduction"
	chapter.5C0000000000A002.title: "Skyseed"
	chapter.5C0000000000A003.title: "Create"
	chapter.5C0000000000A004.title: "Tools \\& Travel"
	chapter.5C0000000000A005.title: "Storage"
	chapter.5C0000000000A006.title: "Power"
	chapter.5C0000000000A007.title: "Mystical Agriculture"
	chapter.5C0000000000A008.title: "Farmer's Delight"
	chapter.5C0000000000A009.title: "Immersive Engineering"
	chapter.5C0000000000A00A.title: "Magic \\& Exploration"
	chapter_group.5C0000000000E001.title: "Progression"
	chapter_group.5C0000000000E002.title: "Industry"
	chapter_group.5C0000000000E003.title: "Farming"
	chapter_group.5C0000000000E004.title: "Magic \\& Exploration"
	quest.5C0000000000B001.quest_desc: [
		"Welcome, skyfarer."
		""
		"There's nothing out here but you, a few seeds, and the sky. Throw a seed and an island grows beneath it — that's how you build a whole world, one island at a time."
		""
		"This book guides you mod by mod: what each one does and the one thing you need to get started. Take it slow — there's no rush in the void."
	]
	quest.5C0000000000B001.quest_subtitle: "Grow your own world"
	quest.5C0000000000B001.title: "Welcome to the Void"
	quest.5C0000000000B002.quest_desc: [
		"Skyseed has its own guide — the Skyfarer's Almanac. It lists every seed: what it grows and what you need to craft the next one."
		""
		"This quest book points you between mods; the Almanac goes deep on seeds. Keep both open."
	]
	quest.5C0000000000B002.title: "Your Almanac"
	quest.5C0000000000B003.quest_desc: [
		"A few helpers run quietly in the background:"
		""
		"§e- JEI§r (right of any inventory): hover an item, press §aR§r for its recipe, §aU§r for what it makes."
		"§e- Jade§r: look at a block or mob to see what it is."
		"§e- Minimap§r (top-right): press §aM§r for the full map — set waypoints once you have a few islands."
		"§e- Vein Mining§r: hold a tool and mine; connected ores break together."
	]
	quest.5C0000000000B003.title: "Tools of the Trade"
	quest.5C0000000000B101.quest_desc: ["Everything starts with an §eIsland Seed§r. Craft one (check JEI or the Almanac), then throw it into the void — an island grows where it lands."]
	quest.5C0000000000B101.title: "Your First Seed"
	quest.5C0000000000B102.quest_desc: [
		"Right-click to throw your seed over open void. Watch the island knit itself together, then land on it."
		""
		"This is your first piece of the world. Build out from here."
	]
	quest.5C0000000000B102.title: "Grow Your World"
	quest.5C0000000000B103.quest_desc: [
		"Different seeds grow different islands — forest, desert, meadow and more. Each gives new blocks, plants and mobs."
		""
		"Gather what each island offers; it's how you craft rarer seeds. The Almanac lists them all."
	]
	quest.5C0000000000B103.title: "A Bigger World"
	quest.5C0000000000B104.quest_desc: [
		"The §eRocky Island§r is your quarry: stone, §eandesite§r, coal, iron, copper — and §ezinc§r, the metal Create runs on."
		""
		"Craft a Rocky Seed and grow one. Mine andesite + iron to start Create; come back for zinc when you need brass."
		""
		"§7Tip: grow a Rocky island §olow§r§7 (below y8) and its core turns to deepslate — that's where deepslate zinc and diamond live.§r"
	]
	quest.5C0000000000B104.quest_subtitle: "Your mine — and the gateway to Create"
	quest.5C0000000000B104.title: "Grow a Rocky Island"
	quest.5C0000000000B105.quest_desc: [
		"Throw a §eRocky§r island §olow§r, near the world's floor, and its body turns to §edeepslate§r — with §ediamonds§r in the dark."
		""
		"Mine deep, then craft an §eAncient Skyseed§r: a deepslate island, and your reliable source of diamond, tuff and the makings of a Trial Chamber."
	]
	quest.5C0000000000B105.quest_subtitle: "The Ancient seed"
	quest.5C0000000000B105.title: "Into the Deep"
	quest.5C0000000000B106.quest_desc: [
		"Every biome seed has a §eLarge§r version — radius 13–17, a deeper ore-rich core, the same biome cues. Craft a §eLarge Wild Skyseed§r — a Wild Skyseed packed round with wood, sand, kelp and dirt — or step up any biome from its own matching blocks."
		""
		"Bigger island, bigger build, more ore. Step up whenever you've outgrown a small one."
	]
	quest.5C0000000000B106.quest_subtitle: "The next size up"
	quest.5C0000000000B106.title: "Large Islands"
	quest.5C0000000000B107.quest_desc: [
		"With a few §eemeralds§r and some §eanimals§r, the §eSettlement§r seeds open up — villages, farms, trading posts and pastures that grow with villagers and livestock already in place."
		""
		"A working village means trades, crops and a renewable economy on your doorstep."
	]
	quest.5C0000000000B107.quest_subtitle: "Villages \\& Farms"
	quest.5C0000000000B107.title: "Good Neighbours"
	quest.5C0000000000B108.quest_desc: [
		"Skyseed grows §estructures§r too — dungeons, temples, outposts and more, each with vanilla loot and the §eStructure Relics§r and §ePortal Frame Shards§r you'll need for the End later."
		""
		"Start with a §eDungeon§r island. Re-grow any structure to re-roll its loot."
	]
	quest.5C0000000000B108.quest_subtitle: "Loot \\& relics"
	quest.5C0000000000B108.title: "Ruins \\& Landmarks"
	quest.5C0000000000B109.quest_desc: [
		"Find any §elava§r — a pool deep in a Rocky isle, or cast your own — and flood it with water to make §eobsidian§r. Build a portal frame, light it, and step through into §ethe Nether§r and its own long climb."
		""
		"§7Optional: a §eRuined Portal Skyseed§r (two obsidian over two gold) grows a ready-made frame with a loot chest and §ecrying obsidian§r — handy, but any lava source will do.§r"
	]
	quest.5C0000000000B109.quest_subtitle: "The Nether opens"
	quest.5C0000000000B109.title: "Through the Portal"
	quest.5C0000000000B110.quest_desc: [
		"Down here, new seeds grow §enether§r islands — basalt, soul sand, crimson and warped forests, lava and netherrack. Quartz, glowstone, gold and nether wood are yours."
		""
		"Build a foothold; it's a long way to the Fortress."
	]
	quest.5C0000000000B110.quest_subtitle: "Nether resources"
	quest.5C0000000000B110.title: "Nether Bound"
	quest.5C0000000000B111.quest_desc: [
		"Grow a §eNether Fortress§r island for §eBlaze Rods§r — the key to Eyes of Ender — and a §eBastion§r for piglin gold and netherite scrap."
		""
		"These are the relics and resources that unlock the End."
	]
	quest.5C0000000000B111.quest_subtitle: "Blaze \\& plunder"
	quest.5C0000000000B111.title: "Fortress \\& Bastion"
	quest.5C0000000000B112.quest_desc: [
		"The §eEnd Portal Skyseed§r is the long way round: four §eportal edges§r, each forged from a §ePortal Frame Shard§r and two §estructure relics§r gathered from across the mod."
		""
		"It grows a stronghold chamber with an empty 12-frame portal. Fill the frames with §eEyes of Ender§r (Blaze Rods + Ender Pearls) and step into §ethe End§r."
		""
		"§7Pack spare seeds — the End grows empty — and stage from home: there's no respawn out there.§r"
	]
	quest.5C0000000000B112.quest_subtitle: "The End opens"
	quest.5C0000000000B112.title: "Eye of the End"
	quest.5C0000000000B113.quest_desc: [
		"Up here a §eForest§r or §eLush§r seed grows §echorus§r instead of trees — the start of the chorus → purpur path."
		""
		"Follow it to grow an §eEnd City§r island: shulkers, an elytra, and the purpur and end-stone to build among the stars."
	]
	quest.5C0000000000B113.quest_subtitle: "Chorus → End City"
	quest.5C0000000000B113.title: "The Chorus Path"
	quest.5C0000000000B114.quest_desc: [
		"You beat the dragon. Bottle its §edragon's breath§r, ring it in §eobsidian§r and §eend stone§r, and forge the §eDragon Trophy Skyseed§r."
		""
		"It grows a grand monument — a stepped dais and four dragon-headed obelisks. Set your one §edragon egg§r on the pedestal yourself. A fitting end to the climb."
	]
	quest.5C0000000000B114.quest_subtitle: "The capstone"
	quest.5C0000000000B114.title: "The Dragon's Trophy"
	quest.5C0000000000B115.quest_desc: [
		"A few islands hide behind something rare — a lucky drop or a far-off biome:"
		""
		"§e- Woodland Mansion§r: a Totem from an evoker (Forest seed in a dark forest, ~1 in 20)."
		"§e- Ocean Monument§r: wet sponge from a Large Aquatic isle over deep ocean."
		"§e- Trial Chamber§r: throw a Rocky or Ancient isle deep for diamond and tuff."
		""
		"See the Almanac's §eRare Catch§r page for the full list."
	]
	quest.5C0000000000B115.quest_subtitle: "Hidden islands"
	quest.5C0000000000B115.title: "The Rare Catch"
	quest.5C0000000000B116.quest_desc: [
		"The §eHuge§r tier rings a §eLarge§r seed between an §eEnder Pearl§r and §eBlaze Powder§r, packed in dirt — so it's gated behind the §eNether§r: blaze powder from a Fortress, ender pearls from piglin bartering or endermen down there. No trip to the End required."
		""
		"What you get: a sprawling landmass with a central lake and a deep, ore-veined body. The biggest island Skyseed grows."
	]
	quest.5C0000000000B116.quest_subtitle: "The biggest tier"
	quest.5C0000000000B116.title: "Huge Horizons"
	quest.5C0000000000B201.quest_desc: [
		"Create begins with §eAndesite Alloy§r — andesite + iron (or zinc) nuggets. Andesite comes from your §eRocky island§r, so grow one first (Skyseed chapter)."
		""
		"§7New to Create? Hold any Create item and press §aW§r to open §ePonder§r — short animated tutorials. They're the best way to learn each block.§r"
	]
	quest.5C0000000000B201.quest_subtitle: "The start of all things Create"
	quest.5C0000000000B201.title: "Andesite Alloy"
	quest.5C0000000000B202.quest_desc: ["Wrap a stripped log in Andesite Alloy for §eAndesite Casing§r — the frame for most early machines: drills, saws, belts."]
	quest.5C0000000000B202.title: "Andesite Casing"
	quest.5C0000000000B203.quest_desc: [
		"Machines need §erotation§r. A §eWater Wheel§r over flowing water (or a windmill) is your first free power; shafts and cogwheels carry it around."
		""
		"§7Every machine draws §eStress§r — add wheels for more. Goggles show the numbers.§r"
	]
	quest.5C0000000000B203.title: "Get It Spinning"
	quest.5C0000000000B204.quest_desc: [
		"A pair of §eCrushing Wheels§r (or a Millstone) grinds ore into §etwice§r the nuggets — doubling everything you mine. On a skyblock, that's gold."
		""
		"Feed ore in on a belt, collect the output. This is what makes your islands' ores go far."
	]
	quest.5C0000000000B204.quest_subtitle: "The skyblock superpower"
	quest.5C0000000000B204.title: "Double Your Ore"
	quest.5C0000000000B205.quest_desc: [
		"Mid-game Create runs on §eBrass§r — copper + §ezinc§r, combined in a heated §eMechanical Mixer§r."
		""
		"This is the zinc gate. Head back to a §eRocky island§r and mine its zinc. Brass unlocks the good stuff: deployers, mechanical arms, mechanical crafters."
	]
	quest.5C0000000000B205.quest_subtitle: "Now you need that zinc"
	quest.5C0000000000B205.title: "Brass"
	quest.5C0000000000B206.quest_desc: [
		"§eCreate: Crafts  Additions§r bridges rotation and §eForge Energy (FE)§r: an §eAlternator§r turns spinning into FE, an §eElectric Motor§r turns FE back into spinning."
		""
		"That FE grid will power the bigger tech mods later. Pair it with §eFlux Networks§r to beam power between islands — no cables across the void."
	]
	quest.5C0000000000B206.title: "Power Up"
	quest.5C0000000000B207.quest_desc: [
		"A §eMechanical Press§r hammers metal into §esheets§r — the ingredient for casings, brass machines and tools."
		""
		"Set a §eBasin§r under a §eMechanical Mixer§r too, and you can combine and wash materials. The press and mixer are your crafting backbone."
	]
	quest.5C0000000000B207.quest_subtitle: "Sheets, mixing  assembly"
	quest.5C0000000000B207.title: "Press It"
	quest.5C0000000000B209.quest_desc: [
		"Brass unlocks Create's §eautomators§r:"
		""
		"§e- Deployer§r: uses tools and places blocks for you."
		"§e- Mechanical Arm§r: shuttles items between machines."
		"§e- Mechanical Crafter§r: assembles crafting recipes on its own."
		""
		"Chain them and your islands start running themselves. Ponder each one (§aW§r) to see how."
	]
	quest.5C0000000000B209.quest_subtitle: "Automation"
	quest.5C0000000000B209.title: "Hands-Free"
	quest.5C0000000000B211.quest_desc: ["§eBetter Motors§r adds stronger, tunable electric motors. One good motor can drive a big contraption straight off your FE grid — no wall of stock motors."]
	quest.5C0000000000B211.quest_subtitle: "Create: Better Motors"
	quest.5C0000000000B211.title: "Bigger Motors"
	quest.5C0000000000B212.quest_desc: ["§eFlux Networks§r ties your power into one wireless FE grid. A §eFlux Plug§r where you generate, a §eFlux Point§r where you need it — energy across the void with no cables."]
	quest.5C0000000000B212.quest_subtitle: "Flux Networks"
	quest.5C0000000000B212.title: "Wireless Watts"
	quest.5C0000000000B213.quest_desc: ["§eSteam'n'Rails§r lets you lay §etrack§r and build real §etrains§r. A station, a powered loco, and your islands are connected — the comfiest way to get around."]
	quest.5C0000000000B213.quest_subtitle: "Steam'n'Rails"
	quest.5C0000000000B213.title: "All Aboard"
	quest.5C0000000000B214.quest_desc: [
		"§eCreate: Enchantment Industry§r automates the tedious parts of enchanting — bottling §eXP§r into a fluid, auto-printing books and disenchanting in bulk."
		""
		"Build it once and never grind levels by hand again."
	]
	quest.5C0000000000B214.quest_subtitle: "Create: Enchantment Industry"
	quest.5C0000000000B214.title: "Enchanted Industry"
	quest.5C0000000000B215.quest_desc: ["Craft §eEngineer's Goggles§r to read stress and fluid levels at a glance — wear them whenever you build. Small Create add-ons fill the gaps in your toolkit."]
	quest.5C0000000000B215.quest_subtitle: "Quality-of-life"
	quest.5C0000000000B215.title: "Goggles  Gadgets"
	quest.5C0000000000B216.quest_desc: ["Build a §eCreate Jetpack§r, fuel it, and fly. Powered from your FE grid, it turns island-hopping into a hop — no scaffolding required."]
	quest.5C0000000000B216.quest_subtitle: "Create: Jetpack"
	quest.5C0000000000B216.title: "Take Flight"
	quest.5C0000000000B217.quest_desc: ["A couple of add-ons widen Create for fun: §eAquatic Ambitions§r (sea machines) and §eDragons Plus§r (new blocks and gadgets). Pure bonus — poke around when you're curious."]
	quest.5C0000000000B217.quest_subtitle: "Content add-ons"
	quest.5C0000000000B217.title: "New Horizons"
	quest.5C0000000000B218.quest_desc: ["Createdeco, Rechiseled, Bells  Whistles, Interiors and Design'n'Decor add hundreds of §edecoration§r blocks — palettes, trims, lamps and furniture to turn a factory into a home."]
	quest.5C0000000000B218.quest_subtitle: "Decoration"
	quest.5C0000000000B218.title: "Make It Beautiful"
	quest.5C0000000000B301.quest_desc: [
		"§eSilent Gear§r builds tools and armor from parts. Craft a §eBlueprint§r for the tool you want, then combine a §emain part§r (the head) with a §erod§r in the grid."
		""
		"The materials you use set the stats — start with stone or iron and upgrade as you find better."
	]
	quest.5C0000000000B301.quest_subtitle: "Silent Gear"
	quest.5C0000000000B301.title: "Forge a Tool"
	quest.5C0000000000B302.quest_desc: [
		"Silent Gear tools grow with you:"
		""
		"§e- Traits§r come from materials — extra durability, speed, luck and more."
		"§e- Repair Kits§r fix tools on the go, no anvil needed."
		"§e- Tips  grips§r add bonuses; re-coat with better materials as you progress."
		""
		"Browse the parts in JEI to plan your perfect tool."
	]
	quest.5C0000000000B302.title: "Make It Yours"
	quest.5C0000000000B401.quest_desc: [
		"Inventory full already? §eSophisticated Backpacks§r gives you a portable, upgradable pack."
		""
		"Craft one, then right-click to open it anywhere. It grows with §eupgrade slots§r — more on those next."
	]
	quest.5C0000000000B401.quest_subtitle: "Sophisticated Backpacks"
	quest.5C0000000000B401.title: "Pack It Up"
	quest.5C0000000000B402.quest_desc: [
		"Drop §eupgrades§r into your pack's slots to make it work for you:"
		""
		"§e- Pickup§r: auto-collects items you walk over."
		"§e- Magnet§r: pulls in drops and XP from range."
		"§e- Stack§r: each slot holds far more."
		"§e- Compacting§r: auto-crafts nuggets → ingots → blocks to save space."
		""
		"Craft them in JEI and slot them in — no more inventory juggling."
	]
	quest.5C0000000000B402.title: "Upgrade Your Pack"
	quest.5C0000000000B403.quest_desc: [
		"For your base, §eSophisticated Storage§r turns barrels and chests into power-houses — the same §eupgrade slots§r (stack, compacting, hopper, smelting) plus tools to sort and search."
		""
		"§7Tip: it ties into Create — funnels and pipes can feed these directly.§r"
	]
	quest.5C0000000000B403.quest_subtitle: "Sophisticated Storage"
	quest.5C0000000000B403.title: "Barrels \\& Boxes"
	quest.5C0000000000B404.quest_desc: [
		"Applied Energistics starts with a crystal. Mine deep into a §eRocky§r or §eAncient§r island and you'll strike small pockets of §bcertus quartz§r."
		""
		"It's the seed of everything AE2 — but on its own it builds no storage. For that you'll need what only a fallen meteorite carries."
	]
	quest.5C0000000000B404.quest_subtitle: "The gateway crystal"
	quest.5C0000000000B404.title: "Certus Quartz"
	quest.5C0000000000B405.quest_desc: [
		"The §bMeteorite Skyseed§r grows the AE2 endgame island. Its recipe is deliberately steep: the §ecertus§r you mined, §eIE steel§r, and a §eCreate precision mechanism§r."
		""
		"Craft it, then throw it — up comes a charred meteorite studded with §bsky stone§r and certus."
	]
	quest.5C0000000000B405.quest_subtitle: "A shard of fallen sky"
	quest.5C0000000000B405.title: "The Meteorite Seed"
	quest.5C0000000000B406.quest_desc: [
		"Grow the meteorite and mine out its §bsky stone§r — the dark meteoric rock the whole ME network is built on."
		""
		"Smelt it smooth for the §eME Controller§r. Sky stone falls nowhere else, so this island is your only quarry — grow another when you need more."
	]
	quest.5C0000000000B406.quest_subtitle: "Sky stone"
	quest.5C0000000000B406.title: "A Fallen Star"
	quest.5C0000000000B407.quest_desc: [
		"Processors need four §einscriber presses§r — Calculation, Engineering, Logic and Silicon. Normally they're meteorite-loot only; here you §epress them from sky stone§r."
		""
		"You only need one of each: after that, duplicate them in the §eInscriber§r with an iron block."
	]
	quest.5C0000000000B407.quest_subtitle: "Pressed from sky stone"
	quest.5C0000000000B407.title: "Inscriber Presses"
	quest.5C0000000000B408.quest_desc: [
		"Build a §eCharger§r and power it to turn certus into §echarged certus quartz§r."
		""
		"It's the first spark of the network — and the first step toward fluix."
	]
	quest.5C0000000000B408.quest_subtitle: "The Charger"
	quest.5C0000000000B408.title: "Spark the Crystal"
	quest.5C0000000000B409.quest_desc: [
		"Toss §echarged certus§r, plain certus, §eredstone§r and §enether quartz§r into a block of water and they fuse into §dfluix crystals§r."
		""
		"Fluix runs through every cable, processor and terminal you'll build."
	]
	quest.5C0000000000B409.quest_subtitle: "The network's lifeblood"
	quest.5C0000000000B409.title: "Fluix"
	quest.5C0000000000B410.quest_desc: [
		"With presses and fluix you can §eprint processors§r in the Inscriber — logic, calculation and engineering."
		""
		"These are the brains of the network: cables, drives, terminals and the controller all want them."
	]
	quest.5C0000000000B410.quest_subtitle: "Print the circuits"
	quest.5C0000000000B410.title: "Processors"
	quest.5C0000000000B411.quest_desc: [
		"§eSmooth sky stone§r + §dfluix§r + an §eengineering processor§r makes the §eME Controller§r."
		""
		"Everything hangs off it. Give it power and channels flow out to your drives, terminals and machines."
	]
	quest.5C0000000000B411.quest_subtitle: "Heart of the network"
	quest.5C0000000000B411.title: "The ME Controller"
	quest.5C0000000000B412.quest_desc: [
		"The §eME Drive§r holds §estorage cells§r — each one a bottomless, searchable chest."
		""
		"Here's a §e1k cell§r to start. Feed the Drive and your inventory chaos is over for good."
	]
	quest.5C0000000000B412.quest_subtitle: "ME Drive \\& storage cells"
	quest.5C0000000000B412.title: "Never Sort a Chest Again"
	quest.5C0000000000B413.quest_desc: [
		"The §eME Terminal§r shows everything in the network on one panel — search it, pull it, dump into it."
		""
		"Swap in a §ecrafting terminal§r and you craft straight from storage."
	]
	quest.5C0000000000B413.quest_subtitle: "Your whole base, one screen"
	quest.5C0000000000B413.title: "ME Terminal"
	quest.5C0000000000B414.quest_desc: [
		"AE2 runs on its own energy, but its §eEnergy Acceptor§r eats §eForge Energy§r directly — no bridge needed."
		""
		"Wire a §eFlux Point§r from your Create → Crafts \\& Additions → Flux grid into the Acceptor and the network is powered. It's the very same FE that already runs your IE machines."
	]
	quest.5C0000000000B414.quest_subtitle: "Forge Energy to AE"
	quest.5C0000000000B414.title: "Power the Network"
	quest.5C0000000000B415.quest_desc: [
		"A §ebudding certus§r block grows crystals on its exposed faces. Speed it up with §eGrowth Accelerators§r, or fully automate it with AE2 Things' §eCrystal Growth Chamber§r."
		""
		"Certus is now infinite — the network feeds itself."
	]
	quest.5C0000000000B415.quest_subtitle: "Endless crystals"
	quest.5C0000000000B415.title: "Grow Your Own Certus"
	quest.5C0000000000B416.quest_desc: [
		"The §eUniversal Wireless Terminal§r puts crafting, patterns and storage in your hand — anywhere within range of a Wireless Access Point."
		""
		"Add a Quantum Bridge Card and it reaches across dimensions."
	]
	quest.5C0000000000B416.quest_subtitle: "The whole network, in your pocket"
	quest.5C0000000000B416.title: "Wireless Access"
	quest.5C0000000000B417.quest_desc: [
		"§eMEGA Cells§r scale storage into the absurd — §e1M§r, 16M, even 256M items in a single cell, plus a MEGA crafting CPU for enormous autocrafts."
		""
		"The true endgame: one wall of drives holds everything you'll ever mine."
	]
	quest.5C0000000000B417.quest_subtitle: "A million items in a cell"
	quest.5C0000000000B417.title: "MEGA Storage"
	quest.5C0000000000B418.quest_desc: [
		"The §eAE Stock Bridge§r links Create's §estock keeper§r to your ME network."
		""
		"Create stock items show up as craftable in AE2, and Create packagers pull straight from your cells — the two mods become one system. Optional, but lovely."
	]
	quest.5C0000000000B418.quest_subtitle: "Two networks, one system"
	quest.5C0000000000B418.title: "Create Meets AE"
	quest.5C0000000000B419.quest_desc: [
		"The §eKinetic Acceptor§r turns Create rotation §edirectly§r into AE power — skipping the Forge-Energy step entirely."
		""
		"A neat alternative if you'd rather spin your network than wire it."
	]
	quest.5C0000000000B419.quest_subtitle: "Rotation, straight to AE"
	quest.5C0000000000B419.title: "Kinetic Power"
	quest.5C0000000000B501.quest_desc: [
		"With islands scattered across the void, walking gets old fast. §eWaystones§r fix that."
		""
		"Craft and place a §eWaystone§r, then right-click to name it. Activate a few and you can teleport between any of them — instant travel across your world."
		""
		"§7A §eWarp Stone§r lets you jump from anywhere back to a waystone, no stone underfoot needed.§r"
	]
	quest.5C0000000000B501.quest_subtitle: "Waystones"
	quest.5C0000000000B501.title: "Set Your Home"
	quest.5C0000000000B502.quest_desc: [
		"Your activated waystones show up right on the §eXaero minimap§r and world map — click one to start travelling, or just use them to keep your bearings."
		""
		"Set a waypoint at each new island and you'll never lose your way in the void."
	]
	quest.5C0000000000B502.title: "On the Map"
	quest.5C0000000000B601.quest_desc: [
		"No farmland out here? No problem. §eBotany Pots§r grow crops, saplings and more with §eno tilled soil needed§r — just the pot and a soil block dropped inside."
		""
		"Craft a §eTerracotta Botany Pot§r and add a soil. Pots are the backbone of farming in the void — and of Mystical Agriculture."
	]
	quest.5C0000000000B601.quest_subtitle: "Botany Pots"
	quest.5C0000000000B601.title: "Pot It Up"
	quest.5C0000000000B602.quest_desc: [
		"§eMystical Agriculture§r lets you §egrow§r resources as crops. It starts with two ores: §eProsperity§r and §eInferium§r."
		""
		"The accessible source is a §eLush§r island — its stone carries both ores. Want them richer? An §eAncient§r island (throw a Rocky seed low) veins the deepslate variants. Either way, mine some ore: §eProsperity Shards§r are the gate — nothing else drops them."
	]
	quest.5C0000000000B602.quest_subtitle: "Mystical Agriculture's ore"
	quest.5C0000000000B602.title: "Prosperity Found"
	quest.5C0000000000B603.quest_desc: [
		"Crush or smelt §eProsperity Ore§r for §eProsperity Shards§r, and gather §eInferium Essence§r — from Inferium Ore, or from §eany mob§r (they all drop a little)."
		""
		"Combine Inferium Essence on §eDirt§r to make §eInferium Farmland§r (your pot soil), and craft a §eProsperity Seed Base§r — the heart of every Mystical seed."
	]
	quest.5C0000000000B603.quest_subtitle: "Inferium → seed base"
	quest.5C0000000000B603.title: "First Essence"
	quest.5C0000000000B604.quest_desc: [
		"Craft an §eInferium Seed§r (Prosperity Seed Base + Inferium Essence) and plant it in a §eBotany Pot§r on §eInferium Farmland§r."
		""
		"Harvest it for more §eInferium Essence§r — a renewable, land-free essence farm. Resource seeds (iron, gold, diamond…) work the same way once you have the materials."
	]
	quest.5C0000000000B604.quest_subtitle: "Grow your first crop"
	quest.5C0000000000B604.title: "Sow a Seed"
	quest.5C0000000000B605.quest_desc: [
		"Essence climbs §eInferium → Prudentium → Tertium → Imperium → Supremium§r — combine four of one tier to make the next."
		""
		"Build an §eInfusion Altar§r and an §eInfusion Crystal§r to craft the bigger seeds, and raise your farmland tier to match higher crops. §7A Growth Accelerator under a pot speeds things up.§r"
	]
	quest.5C0000000000B605.quest_subtitle: "Infusion Altar"
	quest.5C0000000000B605.title: "Climb the Tiers"
	quest.5C0000000000B606.quest_desc: [
		"§eCreate: Mechanical Botany§r adds a §eMechanical Insolator§r — a Create-powered Botany Pot that grows and harvests on its own, driven by §erotation§r (it draws Stress like any Create machine)."
		""
		"Line up insolators on a belt and your essence farms run themselves. Pairs perfectly with the Create power you already have."
	]
	quest.5C0000000000B606.quest_subtitle: "Create: Mechanical Botany"
	quest.5C0000000000B606.title: "Hands-Free Harvest"
	quest.5C0000000000B607.quest_desc: [
		"§eBotany Trees§r lets Botany Pots grow full §etrees§r from saplings — a compact, renewable §ewood§r farm with no land and no axe-swinging."
		""
		"Drop a sapling in a pot with the right soil and let it grow; automate it with the Mechanical Insolator for endless logs."
	]
	quest.5C0000000000B607.quest_subtitle: "Botany Trees"
	quest.5C0000000000B607.title: "Tree Farm"
	quest.5C0000000000B608.quest_desc: [
		"Mine §eSoulium Ore§r off a §eNether Soul§r island, craft a §eSoulium Dagger§r, and use it to harvest §emob souls§r."
		""
		"Those souls craft §eMob Seeds§r — grow zombies, skeletons, creepers and more as crops, for fully renewable mob drops without a spawner."
	]
	quest.5C0000000000B608.quest_subtitle: "Soulium Dagger \\& mob seeds"
	quest.5C0000000000B608.title: "Soul Harvest"
	quest.5C0000000000B609.quest_desc: [
		"§eMystical Agradditions§r adds the §eInsanium§r tier above Supremium — plus §eTier-6 crops§r for the truly rare (Nether Star, Dragon Egg and more), grown on dedicated Crux blocks."
		""
		"This is the deep end of Mystical farming. Build it once and grow almost anything."
	]
	quest.5C0000000000B609.quest_subtitle: "Mystical Agradditions"
	quest.5C0000000000B609.title: "The Insane Tier"
	quest.5C0000000000B701.quest_desc: [
		"The void's biome map is a treasure map. §eOh The Biomes We've Gone§r scatters dozens of wild biomes out there — aspen boreals, jacaranda jungles, cypress swamplands and more — each with its own §eexotic wood§r."
		""
		"Throw a §eForest§r seed over one of those biomes and it grows an island of that wood. Chop it for §eplanks§r no vanilla tree can give you. Twenty-four woods are out there to find."
		""
		"§7Tip: check F3 or the minimap for the biome name before you throw — the biome decides the wood.§r"
	]
	quest.5C0000000000B701.quest_subtitle: "Grow an exotic-wood island"
	quest.5C0000000000B701.title: "Into the Wilds"
	quest.5C0000000000B702.quest_desc: [
		"Some wild biomes bloom instead of grow tall. A §eMeadow§r seed over a BWG grassland (allium shrubland, rose fields, amaranth grassland…) or a §eLush§r seed over a jungle carpets the island in §eexotic flowers§r."
		""
		"Feed those blooms to a §eMillstone§r or §eCrushing Wheels§r and Create turns them into §edyes, petals and powders§r — a whole palette you can only get from the wilds."
	]
	quest.5C0000000000B702.quest_subtitle: "BWG blooms, meet Create"
	quest.5C0000000000B702.title: "Mill the Blooms"
	quest.5C0000000000B703.quest_desc: [
		"§eOh The Trees You'll Grow§r makes saplings grow into big, varied trees — sprawling canopies and shapes far beyond a plain vanilla trunk."
		""
		"Plant any sapling on an island, or drop one in a §eBotany Pot§r, give it room, and watch something grand rise. It works the same on every wood you bring home from the wilds."
	]
	quest.5C0000000000B703.quest_subtitle: "Watch a sapling rise"
	quest.5C0000000000B703.title: "Grow Something Grand"
	quest.5C0000000000B801.quest_desc: [
		"§eFarmer's Delight§r turns farming into cooking — hearty meals, comfort food, a whole cosy kitchen."
		""
		"It starts in the wild. Grown biome islands sprout §ewild crops§r: §eonions§r and §ecarrots§r on Forest and Meadow isles, §ecabbages§r on beaches, §etomatoes§r on desert throws. Harvest a patch — it drops seeds to replant on tilled dirt."
		""
		"§7Tip: wild crops are a scattered find. Throw a few Forest or Meadow seeds if the first island comes up bare.§r"
	]
	quest.5C0000000000B801.quest_subtitle: "Find a wild crop"
	quest.5C0000000000B801.title: "Wild Harvest"
	quest.5C0000000000B802.quest_desc: [
		"The §eCooking Pot§r is the heart of the kitchen. Set it over a §eheat source§r — a campfire, a stove, or a furnace — then drop in ingredients and a bowl and it simmers them into stews and soups."
		""
		"Craft one and place it. Most Farmer's Delight meals come out of this pot."
	]
	quest.5C0000000000B802.quest_subtitle: "Simmer something"
	quest.5C0000000000B802.title: "The Cooking Pot"
	quest.5C0000000000B803.quest_desc: [
		"The §eSkillet§r fries food fast over heat — and doubles as a hefty frying-pan weapon."
		""
		"Reach for it for quick single-serving dishes when you don't want to fire up the whole pot."
	]
	quest.5C0000000000B803.title: "The Skillet"
	quest.5C0000000000B804.quest_desc: [
		"A §eCutting Board§r, paired with a §eKnife§r, processes ingredients by hand — slicing and peeling, turning planks into extra items and logs into bark."
		""
		"§7This pack ships §eChopper's Delight§r, so you can craft a cutting board from §oevery§r wood — vanilla, Nether, and all the exotic BWG planks.§r"
	]
	quest.5C0000000000B804.quest_subtitle: "Cutting Board \\& Knife"
	quest.5C0000000000B804.title: "A Sharp Edge"
	quest.5C0000000000B805.quest_desc: [
		"Time to cook. Simmer a §eVegetable Soup§r — any veg plus a bowl — in the Cooking Pot, or whip up any Farmer's Delight dish."
		""
		"Cooked meals fill more than raw food and often grant a short §ecomfort§r buff. Keep a few in your pack for long island-hops."
	]
	quest.5C0000000000B805.quest_subtitle: "Cook your first meal"
	quest.5C0000000000B805.title: "A Hearty Meal"
	quest.5C0000000000B806.quest_desc: [
		"§eRice§r grows in water. Find §ewild rice§r standing in a §eLush§r island's pond — or in the rivers and swamps of an §eAquatic§r isle — and harvest it."
		""
		"Replant it on tilled dirt beside water and it spreads on its own. Rice opens up rice rolls, medleys and a whole second cuisine."
	]
	quest.5C0000000000B806.quest_subtitle: "The water crop"
	quest.5C0000000000B806.title: "Rice Paddies"
	quest.5C0000000000B807.quest_desc: [
		"Past the portal, §eMy Nether's Delight§r cooks with the Nether's bounty — hoglin roasts, stuffed feasts and spicy stews."
		""
		"§ePowdery Cane§r grows on §eNether Soul§r and §eNether Forest§r islands. Harvest a grown cane for §ePowder Cannon§r — your first Nether ingredient, and the seed to plant more (grow it beside lava and it fruits into §ebullet peppers§r). Then build up to the big hoglin dishes."
	]
	quest.5C0000000000B807.quest_subtitle: "My Nether's Delight"
	quest.5C0000000000B807.title: "Nether Kitchen"
	quest.5C0000000000B808.quest_desc: [
		"At the world's edge, §eEnd's Delight§r makes desserts and dishes from the End's strange harvest — chorus pies, shulker omelettes, even dragon-egg cuisine."
		""
		"§eChorus Succulent§r grows on a §eChorus Forest§r island; gather it to begin. A sweet reward for the long climb out here."
	]
	quest.5C0000000000B808.quest_subtitle: "End's Delight"
	quest.5C0000000000B808.title: "Taste of the End"
	quest.5C0000000000B901.quest_desc: [
		"Immersive Engineering runs on aluminium — its ingots, wires and machine casings all start here."
		""
		"Throw a Rocky island and mine it: alongside the stone it carries aluminium ore (IE's 'bauxite'), plus lead and nickel. Ancient islands instead give aluminium, silver and uranium. Smelt the ore into ingots to begin."
	]
	quest.5C0000000000B901.quest_subtitle: "The gateway metal"
	quest.5C0000000000B901.title: "Bauxite \\& Aluminium"
	quest.5C0000000000B902.quest_desc: [
		"The Engineer's Hammer is the one tool you can't do IE without."
		""
		"You'll use it to form every multiblock (right-click the built shell once), to connect wires, and to configure machines. Craft one and keep it on your hotbar."
	]
	quest.5C0000000000B902.quest_subtitle: "IE's one essential tool"
	quest.5C0000000000B902.title: "The Engineer's Hammer"
	quest.5C0000000000B903.quest_desc: [
		"The Engineer's Manual is IE's own guidebook — and the fastest way to learn the mod."
		""
		"Every multiblock's exact layout and every machine's wiring is drawn out inside. When a quest says 'build the Coke Oven', the manual shows you how. Craft it and read it."
	]
	quest.5C0000000000B903.quest_subtitle: "The built-in guidebook"
	quest.5C0000000000B903.title: "The Engineer's Manual"
	quest.5C0000000000B904.quest_desc: [
		"The Windmill is your first Immersive Engineering power — clean kinetic rotation, no fuel to feed."
		""
		"It loves open sky, and up here the wind never stops. Mount it on a Kinetic Dynamo, high and clear, to turn wind into a trickle of FE."
	]
	quest.5C0000000000B904.quest_subtitle: "Power from the open sky"
	quest.5C0000000000B904.title: "Catch the Wind"
	quest.5C0000000000B905.quest_desc: [
		"IE carries power along wires, not cables or pipes."
		""
		"Put an LV Connector on your generator and another on your machine, then run a Copper Wire Coil between them with the Engineer's Hammer. Low-voltage is the starter tier; MV and HV carry more, further."
	]
	quest.5C0000000000B905.quest_subtitle: "Power runs on wires, not pipes"
	quest.5C0000000000B905.title: "Wire It Up"
	quest.5C0000000000B906.quest_desc: [
		"The Coke Oven is IE's first multiblock — a 3×3×3 of coke brick you form with the hammer."
		""
		"It bakes coal into Coke (a hotter fuel) and drips out Creosote Oil as a by-product. You'll need both for steel. Check the Engineer's Manual for the exact layout."
	]
	quest.5C0000000000B906.quest_subtitle: "Coal into coke"
	quest.5C0000000000B906.title: "Coke Oven"
	quest.5C0000000000B907.quest_desc: [
		"The Crude Blast Furnace is the stepping-stone to steel."
		""
		"Another hammer-formed multiblock, built from blast bricks. Feed it iron and coke and it smelts Steel Ingots — slow and manual, but it's how the backbone metal starts flowing."
	]
	quest.5C0000000000B907.quest_subtitle: "Iron into steel"
	quest.5C0000000000B907.title: "Crude Blast Furnace"
	quest.5C0000000000B908.quest_desc: [
		"Steel is the backbone of everything ahead — the machines, the Excavator, the pump, the reinforced blocks."
		""
		"Put iron and coke into the Crude Blast Furnace and wait. Stock up: almost every IE multiblock from here wants it."
	]
	quest.5C0000000000B908.quest_subtitle: "The backbone alloy"
	quest.5C0000000000B908.title: "Forged in Steel"
	quest.5C0000000000B909.quest_desc: [
		"The Crusher is IE's ore-doubling multiblock — one ore in, two grit out (smelt the grit back into ingots)."
		""
		"It's a big steel-and-concrete build that runs on FE, so it needs a wired power source. Once it's turning, every ore you mine goes twice as far."
	]
	quest.5C0000000000B909.quest_subtitle: "Ore doubling"
	quest.5C0000000000B909.title: "Crush It"
	quest.5C0000000000B910.quest_desc: [
		"The Excavator digs out a whole chunk's mineral vein."
		""
		"Unlike physical ores, IE's mineral veins are per-chunk data — so the Excavator works even over the void. Build it on any island for bulk ore."
	]
	quest.5C0000000000B910.quest_subtitle: "Bulk ore, even over the void"
	quest.5C0000000000B910.title: "The Excavator"
	quest.5C0000000000B911.quest_desc: [
		"The Fluid Pump pulls liquids out of the world and into your pipes."
		""
		"It's what makes crude oil useful — set it over an oil pocket and it draws the fluid up. Powered, and steel-hungry to build."
	]
	quest.5C0000000000B911.quest_subtitle: "Draw fluid from the world"
	quest.5C0000000000B911.title: "Fluid Pump"
	quest.5C0000000000B912.quest_desc: [
		"Crude oil doesn't pool naturally in the void."
		""
		"Throw a Rocky or Ancient island LOW and mine down toward its base — you'll occasionally strike a slick black pocket of crude oil. Pump it out with the IE Fluid Pump, then refine it."
	]
	quest.5C0000000000B912.quest_subtitle: "A slick black pocket near bedrock"
	quest.5C0000000000B912.title: "Striking Oil"
	quest.5C0000000000B913.quest_desc: [
		"Crude oil is worthless until it's refined."
		""
		"The Distillation Tower (an Immersive Petroleum multiblock) cracks crude into Diesel, Lubricant, Naphtha and more. Diesel is the prize — the fuel that powers the generator and your aircraft."
	]
	quest.5C0000000000B913.quest_subtitle: "Crack crude into fuel"
	quest.5C0000000000B913.title: "Refine It"
	quest.5C0000000000B914.quest_desc: [
		"Diesel is refined petroleum — the high-density fuel IE's engines crave."
		""
		"Distil it from crude oil, then bottle a bucketful. It runs the Diesel Generator for serious FE, and tops up an aircraft for the long hauls."
	]
	quest.5C0000000000B914.quest_subtitle: "The engine's lifeblood"
	quest.5C0000000000B914.title: "Diesel"
	quest.5C0000000000B915.quest_desc: [
		"The Diesel Generator is where the whole oil chain pays off."
		""
		"Feed it diesel and it burns fuel into a strong, steady stream of FE — far more than a windmill. Wire it into your grid (see the Power chapter) to run the Excavator, the Crusher, and everything AE2 downstream."
	]
	quest.5C0000000000B915.quest_subtitle: "Fuel to Flux"
	quest.5C0000000000B915.title: "Burn for Power"
	quest.5C0000000000B916.quest_subtitle: "Muscle-powered lift"
	quest.5C0000000000B916.title: "First Flight"
	quest.5C0000000000B917.title: "Build an Engine"
	quest.5C0000000000B918.quest_subtitle: "Fast — mind the runway"
	quest.5C0000000000B918.title: "Take to the Skies"
	quest.5C0000000000B919.title: "The Airship"
	quest.5C0000000000B920.quest_desc: [
		"Your aircraft will burn coal or charcoal, but a tankful doesn't last long."
		""
		"Anything tagged as aircraft fuel works — and refined petroleum goes much further. Distil crude oil into diesel or kerosene and top up your plane for the long hauls. Be aware you need the fuel in a barrel, a bucket will not work."
	]
	quest.5C0000000000B920.quest_subtitle: "Petrol beats coal"
	quest.5C0000000000B920.title: "Aviation Fuel"
	quest.5C0000000000BA01.quest_desc: [
		"You've got a §eWater Wheel§r spinning — now turn that motion into power. Attach an §eAlternator§r (Crafts \\& Additions) to the shaft and it generates §eForge Energy (FE)§r."
		""
		"FE is the pack's §euniversal power§r: everything that isn't Create — Immersive Engineering, Applied Energistics — runs on it. This is where it all starts."
	]
	quest.5C0000000000BA01.quest_subtitle: "Rotation becomes power"
	quest.5C0000000000BA01.title: "First Watts"
	quest.5C0000000000BA02.quest_desc: [
		"A §eCapacitor§r stores FE right where you make it — a local battery."
		""
		"It smooths out the peaks and holds a charge for when the water wheel stalls or demand spikes."
	]
	quest.5C0000000000BA02.quest_subtitle: "A local battery"
	quest.5C0000000000BA02.title: "Buffer It"
	quest.5C0000000000BA03.quest_desc: [
		"§eConnectors§r and wire coils carry FE between machines on the §esame island§r — cheap, simple, line-of-sight."
		""
		"Perfect for wiring a workshop together. For jumping the void, you'll want something wireless…"
	]
	quest.5C0000000000BA03.quest_subtitle: "Wires on one island"
	quest.5C0000000000BA03.title: "Local Wiring"
	quest.5C0000000000BA04.quest_desc: [
		"Cables can't cross the void — but §eFlux Networks§r can. Place a §eFlux Plug§r on your generator island and a §eFlux Point§r on any other; they share §eone wireless grid§r."
		""
		"This is how power reaches every island you grow — no cables strung across the empty sky. The Flux Network is the backbone that ties the whole world together."
	]
	quest.5C0000000000BA04.quest_subtitle: "Wireless power, any island"
	quest.5C0000000000BA04.title: "Across the Void"
	quest.5C0000000000BA05.quest_desc: [
		"§eFlux Storage§r banks the whole network's surplus — charge it while the wheel spins (or the sun shines on a windmill) and draw it down when a big machine kicks in."
		""
		"Bigger tiers hold truly absurd amounts. One good Flux bank and your grid never browns out."
	]
	quest.5C0000000000BA05.quest_subtitle: "Store the whole grid"
	quest.5C0000000000BA05.title: "The Flux Bank"
	quest.5C0000000000BA06.quest_desc: [
		"A water wheel only makes so much. For real output, scale up your §egeneration§r."
		""
		"The §eIE Diesel Generator§r (burn refined oil) pours FE straight onto the same Flux grid — see the §eImmersive Engineering§r chapter for the oil chain. Windmills and steam work too. It all feeds one network."
	]
	quest.5C0000000000BA06.quest_subtitle: "When a water wheel isn't enough"
	quest.5C0000000000BA06.title: "Heavy Generation"
	quest.5C0000000000BA07.quest_desc: [
		"Here's the payoff of one backbone: the §esame FE§r runs your §eIE§r machines and, through an §eEnergy Acceptor§r, powers your entire §eAE2§r network."
		""
		"No converters, no separate systems, no second kind of power to manage. §eGenerate once, power everything.§r"
	]
	quest.5C0000000000BA07.quest_subtitle: "FE feeds it all"
	quest.5C0000000000BA07.title: "One Grid, Every Machine"
	quest.5C0000000000BA08.quest_desc: [
		"Prefer to skip FE entirely? The §eKinetic Acceptor§r feeds Create rotation §edirectly§r into an AE2 network's power."
		""
		"A neat shortcut if you'd rather run a shaft to your ME system than wire it."
	]
	quest.5C0000000000BA08.quest_subtitle: "Rotation, straight to AE"
	quest.5C0000000000BA08.title: "Kinetic Shortcut"
	quest.5C0000000000BB01.quest_desc: [
		"Ring a structure seed with four base biome seeds to craft an Explore Seed."
		""
		"Where a normal seed grows the same island every time, an Explore Seed reads the biome you throw it into and forces a rare structure to germinate — a lucky find, made reliable. Throw it into different biomes to turn up different buildings and their loot."
	]
	quest.5C0000000000BB01.quest_subtitle: "Throw it, find something"
	quest.5C0000000000BB01.title: "The Explore Seed"
	quest.5C0000000000BB02.quest_desc: [
		"Craft the Large Explore Seed — ring the large biome seeds the same way you ringed the base ones."
		""
		"It grows the bigger islands, which host the bigger structures a small isle simply can't hold."
	]
	quest.5C0000000000BB02.quest_subtitle: "The large frontier"
	quest.5C0000000000BB02.title: "Wider Horizons"
	quest.5C0000000000BB03.quest_desc: [
		"Craft the Huge Explore Seed — the largest islands, and the only ones big enough for the grand set-pieces: the Mage's Sanctum, the Frozen Warren, the War Barrow and more."
		""
		"Optional, but it's where the best magic loot lives."
	]
	quest.5C0000000000BB03.quest_subtitle: "Room for a citadel"
	quest.5C0000000000BB03.title: "The Grand Frontier"
	quest.5C0000000000BB04.quest_desc: [
		"Loot a Scroll from an explore structure's chest."
		""
		"A scroll holds a single spell you can cast just once. It's your first taste of Iron's Spells magic — and a hint of what a spellbook could do with that spell, over and over."
	]
	quest.5C0000000000BB04.quest_subtitle: "One cast, then it's spent"
	quest.5C0000000000BB04.title: "A Spell Scroll"
	quest.5C0000000000BB05.quest_desc: [
		"Gather Arcane Essence — the common reagent of Iron's Spells, salted through the chests your explore seeds dig up."
		""
		"You'll want a stack of it; it feeds nearly every arcane recipe."
	]
	quest.5C0000000000BB05.quest_subtitle: "The magic crafting mat"
	quest.5C0000000000BB05.title: "Arcane Essence"
	quest.5C0000000000BB06.quest_desc: [
		"Get a Spellbook — a Copper Spellbook is the humble start. Inscribe a spell into it and you can cast that spell whenever your mana allows, no more one-and-done scrolls."
		""
		"Fancier books hold more spell slots and higher tiers; the copper one is where every mage begins."
	]
	quest.5C0000000000BB06.quest_subtitle: "Cast, and cast again"
	quest.5C0000000000BB06.title: "A Spellbook"
	quest.5C0000000000BB07.quest_desc: ["Craft a Scroll Forge. With arcane essence and the right inks you can forge the scrolls you want, instead of hoping the dungeons drop them."]
	quest.5C0000000000BB07.quest_subtitle: "Write your own scrolls"
	quest.5C0000000000BB07.title: "The Scroll Forge"
	quest.5C0000000000BB08.quest_desc: ["Craft an Arcane Anvil — the mage's workbench. Imbue spells into spellbooks, apply arcane upgrades to your gear, and repair magic equipment here."]
	quest.5C0000000000BB08.quest_subtitle: "Imbue and upgrade"
	quest.5C0000000000BB08.title: "The Arcane Anvil"
	quest.5C0000000000BB09.quest_desc: [
		"Find an Upgrade Orb — the scarce reward that pushes a piece of gear past its normal limits."
		""
		"They drop only in the most dangerous explore structures — the huge tiers — and only rarely. A lucky low roll can still turn one up: that's the dream every throw chases."
	]
	quest.5C0000000000BB09.quest_subtitle: "The rare prize"
	quest.5C0000000000BB09.title: "The Upgrade Orb"
	quest.5C0000000000BB0A.quest_desc: [
		"Find and equip a Relic. Relics level up as you use them and unlock abilities — a belt that quickens your step, a mantle that shields you, and stranger things besides."
		""
		"They hide in the same explore chests. Check this off once you've claimed one."
	]
	quest.5C0000000000BB0A.quest_subtitle: "A living treasure"
	quest.5C0000000000BB0A.title: "Claim a Relic"
	quest.5C0000000000BB0B.quest_desc: [
		"Find and wear an Artifact in a Curio slot — a cloud in a bottle for a double jump, feral claws for faster attacks, and dozens more, each a small permanent perk."
		""
		"Loot one on your travels and slot it in. Check this off once you're wearing one."
	]
	quest.5C0000000000BB0B.quest_subtitle: "A trinket with a trick"
	quest.5C0000000000BB0B.title: "Don an Artifact"
