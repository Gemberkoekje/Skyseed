  "_comment": "Huge Rocky (SKYHUGEPLAN Phase 4): a huge rocky island scaled from the base theme — biome adaptation (4 forms) + internal caves. radius 24-30, dome 12-20. Overworld.",
  "_comment_rare": "VARIETYSTRUCTUREPLAN D5 — flat 5% gate (was ~13% stacked); per-entry chances → weights (round chance×100). The Citadel (w4 of 14) now germinates at ~1.4% — the intended flagship dilution.",
  "rare_structure_chance": 0.05,
  "rare_structures": [
    { "weight": 1, "_comment": "VARIETYSTRUCTUREPLAN Band 3 — Ruined Chapel (vanilla epic; explorable Explore-floor).",
      "jigsaw": { "pool": "skyseed:ruined_chapel/chapel", "target": "minecraft:bottom", "depth": 1, "pad": 6 },
      "mobs": [ { "weight": 1, "entries": [ { "entity": "minecraft:zombie", "adults": 2 }, { "entity": "minecraft:skeleton", "adults": 1 } ] } ] },
    { "weight": 3, "requires": ["irons_spellbooks"], "_comment": "VARIETYSTRUCTUREPLAN Band 2 — Wizard's Tower (inert without Iron's Spells).",
      "jigsaw": { "pool": "skyseed:wizard_tower/tower", "target": "minecraft:bottom", "depth": 1, "pad": 5 },
      "mobs": [ { "weight": 1, "entries": [ { "entity": "irons_spellbooks:archevoker", "adults": 1 }, { "entity": "irons_spellbooks:magehunter_vindicator", "adults": 1 } ] } ] },
    { "weight": 3, "requires": ["ae2"], "_comment": "VARIETYSTRUCTUREPLAN Band 2 — Gutted AE2 Lab (inert without Applied Energistics 2).",
      "jigsaw": { "pool": "skyseed:ae2_lab/lab", "target": "minecraft:bottom", "depth": 1, "pad": 5 },
      "mobs": [ { "weight": 1, "entries": [ { "entity": "minecraft:zombie", "adults": 1 } ] } ] },
    { "weight": 3, "requires": ["immersiveengineering"], "_comment": "VARIETYSTRUCTUREPLAN Band 2 — Dilapidated IE Factory (inert without Immersive Engineering).",
      "jigsaw": { "pool": "skyseed:ie_factory/factory", "target": "minecraft:bottom", "depth": 1, "pad": 5 },
      "mobs": [ { "weight": 1, "entries": [ { "entity": "minecraft:zombie", "adults": 2 } ] } ] },
    { "weight": 3, "requires": ["create"], "_comment": "VARIETYSTRUCTUREPLAN Band 2 — Abandoned Train Shed (Create-gated; inert without Create).",
      "jigsaw": { "pool": "skyseed:train_shed/shed", "target": "minecraft:bottom", "depth": 1, "pad": 5 },
      "mobs": [ { "weight": 1, "entries": [ { "entity": "minecraft:spider", "adults": 1 } ] } ] },
    { "_comment": "Iron's Spells (experimental) — 1:1 reuse of the mod's Mountain Tower (the 'wizard's tower'). MOVED here from rocky_large, which it outgrew (it clipped the smaller island's rim). A lone archmage + a mage-hunter guard defend it (the mod's own structure carries no spawns on our jigsaw copies — see the guardian note in IRONSTRUCTUREREBUILDPLAN.md). INERT without Iron's Spells (rollRare hasTemplatePool guard). Auto-centred on the island (blank-target re-centre in Jigsaw). Playtest the fit; tune pad/depth if needed.",
      "weight": 4,
      "jigsaw": { "pool": "irons_spellbooks:mountain_tower_pool", "target": "", "depth": 2, "pad": 8, "sink": 3 },
      "mobs": [ { "weight": 1, "entries": [ { "entity": "irons_spellbooks:archevoker", "adults": 1 }, { "entity": "irons_spellbooks:magehunter_vindicator", "adults": 1 } ] } ] },
    { "_comment": "Mage's Sanctum — skyseed's home-curated rebuild of Iron's Spells' Citadel (the mod's flagship fortress was too big even for this tier — owner playtest). One bounded ~15×15 × ~25-tall keep: rampart skirt + corner turrets, an entrance hall, a double-height LIBRARY (bookshelf walls, mezzanine, chandeliers — the showpiece), a keeper's chamber (throne + ominous-reward chest), a deepslate spire, and a buried Vault (trial Vault + mansion chest), all linked by a ladder core. sink 4 seats the hall floor at the surface + buries the vault. The citadel_keeper (boss) presides; a hostile priest, two animated cursed armour stands, and a lurking mimic (Artifacts) guard the halls and vault — all from the mobs pack (inert-safe; unknown ids skip). Not a mod pool — always present. See IRONSTRUCTUREREBUILDPLAN.md §Citadel.",
      "weight": 4,
      "jigsaw": { "pool": "skyseed:citadel/keep", "target": "minecraft:bottom", "depth": 1, "pad": 15, "sink": 5 },
      "mobs": [ { "weight": 1, "entries": [ { "entity": "irons_spellbooks:citadel_keeper", "adults": 1 }, { "entity": "irons_spellbooks:priest", "adults": 1 }, { "entity": "irons_spellbooks:cursed_armor_stand", "adults": 2 }, { "entity": "artifacts:mimic", "adults": 1 } ] } ] },
    {
      "_comment": "2.5% — a Sprawling Dungeon complex (dungeon_complex/) sunk into the mountain: cobble/mossy rooms + corridors, spawners, loot, a treasure vault. (SKYDUNGEONPLAN Part A.)",
      "weight": 3,
      "jigsaw": {
        "pool": "skyseed:dungeon_complex/start",
        "target": "minecraft:bottom",
        "depth": 4,
        "_comment_pad": "pad 0: this complex is fully buried (sink 10, < 5 tall), so it needs no levelled surface foundation — a pad would only flatten a bald disc on the mountaintop for a building that isn't there.",
        "pad": 0,
        "sink": 10
      },
      "mobs": []
    },
    {
      "_comment": "2.5% — an Abandoned Mineshaft (mineshaft/) carved through the mountain: oak-plank tunnels with support arches, rails, cobwebs, cave-spider nests + chest minecarts. (SKYDUNGEONPLAN Part B.)",
      "weight": 3,
      "jigsaw": {
        "pool": "skyseed:mineshaft/start",
        "target": "minecraft:bottom",
        "depth": 4,
        "_comment_pad": "pad 0: fully buried (sink 10, ~3 tall) — no surface foundation needed, so no bald disc on the mountaintop.",
        "pad": 0,
        "sink": 10,
        "reach": 24,
        "trestles": true
      },
      "mobs": []
    }
  ]
